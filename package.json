{
  "name": "cognerd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CogNerd mock MCP server — AI visibility intelligence and optimization widgets",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
