    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  },
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
