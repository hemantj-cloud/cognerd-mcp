# =============================================================================
# NitroStack Server Transport Configuration
# =============================================================================
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# =============================================================================
# OAuth 2.1 Configuration (CogNerd Native OAuth Gateway)
# =============================================================================
# OAUTH_REQUIRED controls whether authentication is enforced.
#   - false: permissive — server runs out-of-the-box, protected tools are
#     reachable without a token (best for local dev).
#   - true:  fail-closed — all protected tools reject requests without a valid
#     Bearer token.
OAUTH_REQUIRED=true

# Resource URI (Public identity of the MCP server)
# Matches CogNerd's live MCP endpoint
RESOURCE_URI=https://cognerd-6ab6bd50-amans-org-43ae3aeb.app.nitrocloud.ai/mcp

# CogNerd Authorization Server URL (MCP Gateway Origin)
AUTH_SERVER_URL=https://cognerd-6ab6bd50-amans-org-43ae3aeb.app.nitrocloud.ai

# Token validation audience & issuer
TOKEN_AUDIENCE=https://cognerd-6ab6bd50-amans-org-43ae3aeb.app.nitrocloud.ai/mcp
TOKEN_ISSUER=https://cognerd-6ab6bd50-amans-org-43ae3aeb.app.nitrocloud.ai

# Dynamic Client Registration (RFC 7591) & CIMD Support
OAUTH_ENABLE_CLIENT_REGISTRATION=true
OAUTH_CLIENT_ID=cognerd-chatgpt

# =============================================================================
# CogNerd Specific Settings
# =============================================================================
COGNERD_API_BASE_URL=https://api.cognerd.in

# Scope: 'cognerd' is the single supported scope per CogNerd specification
COGNERD_SCOPE=cognerd

# CogNerd REST API
COGNERD_REST_BASE_URL=https://api.cognerd.in

# CogNerd OAuth Endpoints
COGNERD_AUTH_URL=https://api.cognerd.in/authorize
COGNERD_TOKEN_URL=https://api.cognerd.in/token
COGNERD_REDIRECT_URI=http://localhost:3005/auth/callback

# Optional static user token override (leave empty to require dynamic token per client request)
# COGNERD_ACCESS_TOKEN=

# Mock mode (set to true to use offline mock fixtures without contacting upstream)
COGNERD_MOCK_MODE=false

# Mapbox Configuration (Optional)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

