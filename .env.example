# =============================================================================
# NitroStack Server Transport Configuration
# =============================================================================
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# MCP Protocol Version (Optional)
# NITRO_MCP_PROTOCOL_VERSION selects which MCP wire revision NitroStack speaks.
# Unset (default) keeps the current 2025-era sessionful behavior, unchanged.
#   - 2026-07-28 : the new stateless spec (server/discover, per-request _meta,
#                  Mcp-Method/Mcp-Name headers, cache hints, MRTR, extensions).
#   - auto       : serve both eras from one process (validate mixed clients).
# NITRO_MCP_PROTOCOL_VERSION=2026-07-28

# =============================================================================
# OAuth 2.1 Configuration (CogNerd Native OAuth Gateway)
# =============================================================================
# Set OAUTH_REQUIRED=false for local dev (permissive), true for production (fail-closed)
OAUTH_REQUIRED=false

# Resource URI (Public identity of the MCP server)
RESOURCE_URI=https://mcp-185-131-53-177.sslip.io/mcp

# CogNerd Authorization Server URL
AUTH_SERVER_URL=https://mcp-185-131-53-177.sslip.io

# Expected token validation audience & issuer
TOKEN_AUDIENCE=https://mcp-185-131-53-177.sslip.io/mcp
TOKEN_ISSUER=https://mcp-185-131-53-177.sslip.io

# Dynamic Client Registration (Public client - no client secret)
OAUTH_ENABLE_CLIENT_REGISTRATION=true

# =============================================================================
# CogNerd Specific Settings
# =============================================================================
COGNERD_API_BASE_URL=https://mcp-185-131-53-177.sslip.io

# Scope: 'cognerd' is the single supported scope per CogNerd specification
COGNERD_SCOPE=cognerd

# CogNerd OAuth Endpoints
COGNERD_AUTH_URL=https://mcp-185-131-53-177.sslip.io/authorize
COGNERD_TOKEN_URL=https://mcp-185-131-53-177.sslip.io/token
COGNERD_REDIRECT_URI=http://localhost:3005/auth/callback

# Sandbox Account Info (from CogNerd Partner Kit):
# Login Email: nitrostack.sandbox@cognerd.ai
# Password:    VDAPdpRAWFobUhyb
# Brand:       CogNerd (https://www.cognerd.ai)
# Credits:     500

COGNERD_MOCK_MODE=false

# =============================================================================
# Mapbox Configuration (Optional)
# =============================================================================
# The map widget uses Mapbox GL for interactive maps.
# Get a free API key at: https://www.mapbox.com/
# =============================================================================

# Your Mapbox Public Token (starts with pk.)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
