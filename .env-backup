# =============================================================================
# NitroStack Server Transport Configuration
# =============================================================================
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# =============================================================================
# OAuth 2.1 Configuration
# =============================================================================
# Set OAUTH_REQUIRED=false for local dev (permissive), true for production (fail-closed)
OAUTH_REQUIRED=false

# Resource URI (Public identity of the MCP server)
# In Auth0: APIs -> CogNerd MCP API -> Identifier
RESOURCE_URI=https://mcplocal

# Auth0 Authorization Server URL
AUTH_SERVER_URL=https://dev-yourtenant.us.auth0.com

# Cryptographic JWKS Signature Verification (RFC 7517)
JWKS_URI=https://dev-yourtenant.us.auth0.com/.well-known/jwks.json

# Expected token validation audience & issuer
TOKEN_AUDIENCE=https://mcplocal
TOKEN_ISSUER=https://dev-yourtenant.us.auth0.com/

# Dynamic Client Registration / Static Client Credentials
OAUTH_ENABLE_CLIENT_REGISTRATION=true
OAUTH_CLIENT_ID=your_auth0_client_id
OAUTH_CLIENT_SECRET=your_auth0_client_secret

# Optional Token Introspection
# INTROSPECTION_ENDPOINT=https://dev-yourtenant.us.auth0.com/oauth/token/introspect
# INTROSPECTION_CLIENT_SECRET=your_introspection_secret

# =============================================================================
# CogNerd Specific Settings
# =============================================================================
COGNERD_API_BASE_URL=https://api.cognerd.ai

# Space-separated scopes advertised in OAuth discovery metadata.
# The config loader splits this on whitespace into scopesSupported: string[].
COGNERD_SCOPE=read:visibility write:visibility admin

# Client identity used when THIS server acts as an OAuth client
# (authorization URL construction + PKCE token exchange in OAuthService).
# Falls back to OAUTH_CLIENT_ID, then to 'nitrostack_mcp'.
COGNERD_CLIENT_ID=your_auth0_client_id

# Optional endpoint overrides — derived from AUTH_SERVER_URL when omitted:
# COGNERD_AUTH_URL=https://dev-yourtenant.us.auth0.com/oauth/authorize
# COGNERD_TOKEN_URL=https://dev-yourtenant.us.auth0.com/oauth/token
# COGNERD_REDIRECT_URI=https://mcp.nitrostack.dev/oauth/callback

# Optional: bootstrap a pre-obtained access token directly (skips the PKCE flow)
# COGNERD_ACCESS_TOKEN=

COGNERD_MOCK_MODE=true

# Mapbox Configuration (Optional)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
