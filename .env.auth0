# =============================================================================
# NitroStack Server Transport Configuration
# =============================================================================
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# =============================================================================
# OAuth 2.1 Configuration
# =============================================================================
# OAUTH_REQUIRED controls whether authentication is enforced.
#   - false: permissive — server runs out-of-the-box, protected tools are
#     reachable without a token (best for local dev).
#   - true:  fail-closed — all protected tools reject requests without a valid
#     Bearer token. Requires a verifier (JWKS_URI or INTROSPECTION_ENDPOINT).
OAUTH_REQUIRED=true

# Resource URI (Public identity of the MCP server)
# MUST match the Auth0 API Identifier (APIs → CogNerd MCP API → Identifier) EXACTLY
RESOURCE_URI=http://localhost:3000/mcp

# Auth0 Authorization Server URL (tenant domain)
AUTH_SERVER_URL=https://dev-jrf0vcwukzw1ux6z.us.auth0.com

# Cryptographic JWKS Signature Verification (RFC 7517)
JWKS_URI=https://dev-jrf0vcwukzw1ux6z.us.auth0.com/.well-known/jwks.json

# Expected token validation audience & issuer
TOKEN_AUDIENCE=http://localhost:3000/mcp
TOKEN_ISSUER=https://dev-jrf0vcwukzw1ux6z.us.auth0.com/

# Dynamic Client Registration / Static Client Credentials
# Exposes /oauth/v2/register, serving the statically configured client below.
OAUTH_ENABLE_CLIENT_REGISTRATION=true
OAUTH_CLIENT_ID=00Rwdc79aofEkA82EZ8kqzpVGiTEFQJE
OAUTH_CLIENT_SECRET=WdRZpNuvIZHHJNti7DL_Xfpg_BmgxL6dziwwP2e2FGyzryjXrWyRTOrVVkLqhU9_

# Optional Token Introspection
# INTROSPECTION_ENDPOINT=https://dev-jrf0vcwukzw1ux6z.us.auth0.com/oauth/token/introspect
# INTROSPECTION_CLIENT_SECRET=your_introspection_secret

# =============================================================================
# CogNerd Specific Settings
# =============================================================================
COGNERD_API_BASE_URL=https://api.cognerd.ai

# Space-separated scopes advertised in OAuth discovery metadata.
# The config loader splits this on whitespace into scopesSupported: string[].
# Must match the Permissions configured on the Auth0 API.
COGNERD_SCOPE=read:visibility write:visibility admin

# Client identity used when THIS server acts as an OAuth client
# (authorization URL construction + PKCE token exchange in OAuthService).
# Falls back to OAUTH_CLIENT_ID, then to 'nitrostack_mcp'.
COGNERD_CLIENT_ID=00Rwdc79aofEkA82EZ8kqzpVGiTEFQJE

# Optional endpoint overrides — derived from AUTH_SERVER_URL when omitted:
# COGNERD_AUTH_URL=https://dev-jrf0vcwukzw1ux6z.us.auth0.com/oauth/authorize
# COGNERD_TOKEN_URL=https://dev-jrf0vcwukzw1ux6z.us.auth0.com/oauth/token
# COGNERD_REDIRECT_URI=https://mcp.nitrostack.dev/oauth/callback

# Optional: bootstrap a pre-obtained access token directly (skips the PKCE flow)
# COGNERD_ACCESS_TOKEN=

COGNERD_MOCK_MODE=true

# Mapbox Configuration (Optional)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
